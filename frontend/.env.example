# ─────────────────────────────────────────────
#  TeachLearn Frontend — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Backend API ───────────────────────────────
# Local development
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production (uncomment and set when deploying)
# VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1

# ── Firebase Web SDK ──────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App → SDK setup
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
