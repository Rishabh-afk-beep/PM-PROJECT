# ─────────────────────────────────────────────
#  TeachLearn Backend — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Firebase Admin SDK ────────────────────────
# Path to your Firebase service account JSON key (download from Firebase Console)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=./google-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Admin Allowlist ───────────────────────────
# Comma-separated list of emails that get admin role automatically on first login
ADMIN_EMAILS=admin@yourdomain.com

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Add your production URL here when deploying
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── Dev / Debug ───────────────────────────────
# Set to "true" ONLY during local development to bypass Firebase auth.
# MUST be "false" in production.
DEV_AUTH_MODE=false
