# =============================================================================
#  TeachLearn — Root .gitignore
#  Covers: monorepo root, frontend (Vite/React), and backend (FastAPI/Python)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
#  SECRETS — NEVER commit these
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Firebase / Google service account keys (all patterns)
*firebase-adminsdk*.json
*google-credentials*.json
*service-account*.json
*credentials*.json
google-credentials.json

# Allow safe template files
!.env.example
!**/.env.example

# ─────────────────────────────────────────────────────────────────────────────
#  NODE / VITE / REACT (Frontend)
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/

# Bun
bun.lockb

# ─────────────────────────────────────────────────────────────────────────────
#  PYTHON / FASTAPI (Backend)
# ─────────────────────────────────────────────────────────────────────────────
# Virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checkers
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
*.egg-info/
*.egg
.eggs/

# ─────────────────────────────────────────────────────────────────────────────
#  LOGS
# ─────────────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
#  OS FILES
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
ehthumbs.db

# ─────────────────────────────────────────────────────────────────────────────
#  EDITOR / IDE
# ─────────────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.swn
